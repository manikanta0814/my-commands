next we can add maven config so settings---add maven---- click save---
pipeline {
    agent any
    tools {
        maven 'mymaven'
    }

    stages {
        stage('code') {
            steps {
                //this stage is used to git the code from the github
                git 'https://github.com/manikanta0814/one.git'
            }
        }
        stage("Build") {
            steps {
                sh "mvn clean install"
            }
        }
    }
}
