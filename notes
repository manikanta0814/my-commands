Sample Step
---deploy: Deploy war/ear to a container
WAR/EAR files
---target/*war
Context path
---myapp
Containers
---Tomcat 9.x Remote
Delete
Credentials
---tomcat/****** (tomcat credentials)
Add
Tomcat URL
--http://13.61.24.31:8080/manager/html
Generate Pipeline Script
deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat', path: '', url: 'http://13.61.24.31:8080/manager/html')], contextPath: 'myapp', war: 'target/*war'
pipeline {
    agent any
    tools {
        maven 'mymaven'
    }

    stages {
        stage('code') {
            steps {
                //this stage is used to git the code from the github
                git 'https://github.com/manikanta0814/one.git'
            }
        }
        stage("Build") {
            steps {
                sh "mvn clean install"
            }
        }
        stage ("Deploy") {
            steps {
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat', path: '', url: 'http://13.61.24.31:8080/manager/html')], contextPath: 'myapp', war: 'target/*war'
            }
        }
    }
}
after that refresh tomcat website and see the output myapp.
Task is integrate with nexus.
install plugin nexus artifact
pipeline {
    agent any
    tools {
        maven 'mymaven'
    }

    stages {
        stage('code') {
            steps {
                //this stage is used to git the code from the github
                git 'https://github.com/manikanta0814/one.git'
            }
        }
        stage("Build") {
            steps {
                sh "mvn clean install"
            }
        }
        stage("artifact") {
            steps {
                //script
            }
        }
        stage ("Deploy") {
            steps {
                deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'tomcat', path: '', url: 'http://13.61.24.31:8080/manager/html')], contextPath: 'myapp', war: 'target/*war'
            }
        }
    }
}

