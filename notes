pipeline {
    agent any
    environment {
        profile = "Manikanta"
        company = "TCS"
        year = 2.5
        domain = ".net"
    }
    stages {
        stage ("code") {
            steps {
                echo "My name is $profile $app"
            }
        }
        stage ("Build") {
            environment {
                place = "hyderabad"
            }
            steps {
                echo "I am working in $company in $place and learning $app"
            }
        }
        stage ("Deploy") {
            steps {
                echo "I have $year of exp in $domain"
            }
        }
        stage ("app") {
            steps {
                echo "I am learning $app"
            }
        }
    }
}
If pipeline ----success/Fail/Abort we want get message like mail or Slack(Real time communitcation) that means notification 
pipeline {
    agent any
    environment {
        profile = "Manikanta"
        company = "TCS"
        year = 2.5
        domain = ".net"
    }
    stages {
        stage ("code") {
            steps {
                echo "My name is $profile $app"
            }
        }
        stage ("Build") {
            environment {
                place = "hyderabad"
            }
            steps {
                echo "I am working in $company in $place and learning $app"
                sleep 10
            }
        }
        stage ("Deploy") {
            steps {
                echo "I have $year of exp in $domain"
            }
        }
        stage ("app") {
            steps {
                echo "I am learning $app"
            }
        }
    } 
    post {
        success {
            echo "pipline is success"
        }
        failure {
            echo "failed"
        }
        aborted {
            echo "abort my pipline"
        }
    }
}

