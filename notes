            }
in ur pipeline script stages Ex:-
pipeline {
    agent any
    environment {
        done ="finish"
        status ="now"
    }

    stages {
        stage('code') {
            input {
                message "can i deploy"
            }
            steps {
                echo "my work $done"
            }
        }
        stage('build') {
            steps {
                echo "what ur doing $status"
            }
        }
    }
    post {
        always {
            
            mail to: 'nekuyandhukuranamil@gmail.com',
            subject: "Build Status: ${currentBuild.fullDisplayName}",
            body: "The build ${env.BUILD_NUMBER} finished with status: ${currentBuild.currentResult}. View logs at: ${env.BUILD_URL}"
        
        }
    }
}

