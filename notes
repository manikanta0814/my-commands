pipeline {
    agent any
    environment {
        profile = "Manikanta"
        company = "TCS"
        year = 2.5
        domain = ".net"
    }
    stages {
        stage ("code") {
            steps {
                echo "My name is $profile $app"
            }
        }
        stage ("Build") {
            environment {
                place = "hyderabad"
            }
            steps {
                echo "I am working in $company in $place and learning $app"
                sh "printenv"
            }
        }
        stage ("Deploy") {
            steps {
                echo "I have $year of exp in $domain"
            }
        }
        stage ("app") {
            steps {
                echo "I am learning $app"
            }
        }
    } 
    post {
        always {
            
            mail to: 'nekuyandhukuranamil@gmail.com',
            subject: "Build Status: ${currentBuild.fullDisplayName}",
            body: "The build ${env.BUILD_NUMBER} finished with status: ${currentBuild.currentResult}. View logs at: ${env.BUILD_URL}"
        
        }
    }
}

