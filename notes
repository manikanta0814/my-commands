jenkins pipeline vairables 
EX :- 
pipeline {
    agent any
    environment {
        profile = "Manikanta"
        company = "TCS"
        year = 2.5
        domain = ".net"
    }
    stages {
        stage ("code") {
            steps {
                echo "My name is $profile"
            }
        }
        stage ("Build") {
            environment {
                place = "hyderabad"
            }
            steps {
                echo "I am working in $company in $place"
            }
        }
        stage ("Deploy") {
            steps {
                echo "I have $year of exp in $domain"
            }
        }
    }
} 

